  <avrgcc.compiler.warnings.AllWarnings>True</avrgcc.compiler.warnings.AllWarnings>
  <avrgcc.compiler.miscellaneous.OtherFlags>-gdwarf-2 -std=gnu99 -fgnu89-inline</avrgcc.compiler.miscellaneous.OtherFlags>
  <avrgcc.assembler.general.IncludePaths><ListValues><Value>..\..\Gemeinsam</Value><Value>..\..\..\C-Libs</Value><Value>%24(PackRepoDir)\atmel\ATmega_DFP\1.3.300\include</Value></ListValues></avrgcc.assembler.general.IncludePaths>
