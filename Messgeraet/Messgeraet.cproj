  <PropertyGroup Condition=" '$(Configuration)' == '75Baud' ">
    <OutputPath>bin\75Baud\</OutputPath>
    <ToolchainSettings>
      <AvrGcc>
        <avrgcc.common.Device>-mmcu=atmega168 -B "%24(PackRepoDir)\atmel\ATmega_DFP\1.3.300\gcc\dev\atmega168"</avrgcc.common.Device>
