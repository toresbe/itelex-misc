<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <SchemaVersion>2.0</SchemaVersion>
    <ProjectVersion>7.0</ProjectVersion>
    <ToolchainName>com.Atmel.AVRGCC8.C</ToolchainName>
    <ProjectGuid>2919fe10-c78f-47d7-87ac-0e93ac24ffdd</ProjectGuid>
    <Name>Hellschreiber</Name>
    <avrdevice>atmega168</avrdevice>
    <avrdeviceseries>none</avrdeviceseries>
    <AvrProjectType>Importer</AvrProjectType>
    <OutputType>Executable</OutputType>
    <Language>C</Language>
    <OutputFileName>Hellschreiber</OutputFileName>
    <OutputFileExtension>.elf</OutputFileExtension>
    <OutputDirectory>$(MSBuildProjectDirectory)\$(Configuration)</OutputDirectory>
    <ToolchainFlavour>Native</ToolchainFlavour>
    <avrtool />
    <KeepTimersRunning>true</KeepTimersRunning>
    <OverrideVtor>false</OverrideVtor>
    <CacheFlash>true</CacheFlash>
    <ProgFlashFromRam>true</ProgFlashFromRam>
    <RamSnippetAddress>0x20000000</RamSnippetAddress>
    <UncachedRange />
    <preserveEEPROM>true</preserveEEPROM>
    <OverrideVtorValue>exception_table</OverrideVtorValue>
    <BootSegment>2</BootSegment>
    <ResetRule>0</ResetRule>
    <eraseonlaunchrule>0</eraseonlaunchrule>
    <EraseKey />
    <AsfFrameworkConfig>
      <framework-data xmlns="">
  <options />
  <configurations />
  <files />
  <documentation help="" />
  <offline-documentation help="" />
  <dependencies>
    <content-extension eid="atmel.asf" uuidref="Atmel.ASF" version="3.49.1" />
  </dependencies>
</framework-data>
    </AsfFrameworkConfig>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'default' ">
    <OutputPath>bin\default\</OutputPath>
    <ToolchainSettings>
      <AvrGcc>
  <avrgcc.common.Device>-mmcu=atmega168 -B "%24(PackRepoDir)\atmel\ATmega_DFP\1.6.364\gcc\dev\atmega168"</avrgcc.common.Device>
  <avrgcc.common.outputfiles.hex>True</avrgcc.common.outputfiles.hex>
  <avrgcc.common.outputfiles.lss>True</avrgcc.common.outputfiles.lss>
  <avrgcc.common.outputfiles.eep>True</avrgcc.common.outputfiles.eep>
  <avrgcc.common.outputfiles.srec>True</avrgcc.common.outputfiles.srec>
  <avrgcc.common.outputfiles.usersignatures>False</avrgcc.common.outputfiles.usersignatures>
  <avrgcc.compiler.general.ChangeDefaultCharTypeUnsigned>True</avrgcc.compiler.general.ChangeDefaultCharTypeUnsigned>
  <avrgcc.compiler.general.ChangeDefaultBitFieldUnsigned>True</avrgcc.compiler.general.ChangeDefaultBitFieldUnsigned>
  <avrgcc.compiler.symbols.DefSymbols>
    <ListValues>
      <Value>F_CPU=14000000UL</Value>
      <Value>__PROG_TYPES_COMPAT__</Value>
    </ListValues>
  </avrgcc.compiler.symbols.DefSymbols>
  <avrgcc.compiler.directories.IncludePaths>
    <ListValues>
      <Value>..\..\Gemeinsam</Value>
      <Value>..\..\..\C-Libs</Value>
      <Value>%24(PackRepoDir)\atmel\ATmega_DFP\1.6.364\include\</Value>
    </ListValues>
  </avrgcc.compiler.directories.IncludePaths>
  <avrgcc.compiler.optimization.level>Optimize more (-O2)</avrgcc.compiler.optimization.level>
  <avrgcc.compiler.optimization.PackStructureMembers>True</avrgcc.compiler.optimization.PackStructureMembers>
  <avrgcc.compiler.optimization.AllocateBytesNeededForEnum>True</avrgcc.compiler.optimization.AllocateBytesNeededForEnum>
  <avrgcc.compiler.warnings.AllWarnings>True</avrgcc.compiler.warnings.AllWarnings>
  <avrgcc.compiler.miscellaneous.OtherFlags>-gdwarf-2 -std=gnu99</avrgcc.compiler.miscellaneous.OtherFlags>
  <avrgcc.assembler.general.AssemblerFlags>-Wall -gdwarf-2 -std=gnu99     -DF_CPU=14000000UL -O2 -funsigned-char -funsigned-bitfields -fpack-struct -fshort-enums</avrgcc.assembler.general.AssemblerFlags>
  <avrgcc.assembler.general.IncludePaths>
    <ListValues>
      <Value>..\..\Gemeinsam</Value>
      <Value>..\..\..\C-Libs</Value>
      <Value>%24(PackRepoDir)\atmel\ATmega_DFP\1.6.364\include\</Value>
    </ListValues>
  </avrgcc.assembler.general.IncludePaths>
</AvrGcc>
    </ToolchainSettings>
    <BuildTarget>all</BuildTarget>
    <CleanTarget>clean</CleanTarget>
  </PropertyGroup>
  <Import Project="$(AVRSTUDIO_EXE_PATH)\\Vs\\Compiler.targets" />
  <ItemGroup>
    <Compile Include="HellFont.h">
      <SubType>compile</SubType>
    </Compile>
    <Compile Include="hellgeber.h">
      <SubType>compile</SubType>
    </Compile>
    <Compile Include="ports.h">
      <SubType>compile</SubType>
    </Compile>
    <Compile Include="Taste.h">
      <SubType>compile</SubType>
    </Compile>
    <Compile Include="..\Gemeinsam\BaudotCode.h">
      <SubType>compile</SubType>
      <Link>BaudotCode.h</Link>
    </Compile>
    <Compile Include="..\Gemeinsam\BusKomm.h">
      <SubType>compile</SubType>
      <Link>BusKomm.h</Link>
    </Compile>
    <Compile Include="..\Gemeinsam\FifoPuffer.h">
      <SubType>compile</SubType>
      <Link>FifoPuffer.h</Link>
    </Compile>
    <Compile Include="..\Gemeinsam\SeriellUmsetz.h">
      <SubType>compile</SubType>
      <Link>SeriellUmsetz.h</Link>
    </Compile>
    <Compile Include="..\Gemeinsam\TxP2-Defs.h">
      <SubType>compile</SubType>
      <Link>TxP2-Defs.h</Link>
    </Compile>
    <Compile Include="..\Gemeinsam\TxP2-Endgeraet.h">
      <SubType>compile</SubType>
      <Link>TxP2-Endgeraet.h</Link>
    </Compile>
    <Compile Include="Hellgeber.c">
      <SubType>compile</SubType>
      <CustomCompilationSetting Condition="'$(Configuration)' == 'default'">
      </CustomCompilationSetting>
    </Compile>
    <Compile Include="Hellschreiber.c">
      <SubType>compile</SubType>
      <CustomCompilationSetting Condition="'$(Configuration)' == 'default'">
      </CustomCompilationSetting>
    </Compile>
    <Compile Include="Taste.c">
      <SubType>compile</SubType>
      <CustomCompilationSetting Condition="'$(Configuration)' == 'default'">
      </CustomCompilationSetting>
    </Compile>
    <Compile Include="..\Gemeinsam\SeriellUmsetz.c">
      <SubType>compile</SubType>
      <Link>SeriellUmsetz.c</Link>
    </Compile>
    <Compile Include="..\Gemeinsam\TxP2-Endgeraet.c">
      <SubType>compile</SubType>
      <Link>TxP2-Endgeraet.c</Link>
    </Compile>
    <Compile Include="..\..\C-Libs\MsTimer.c">
      <SubType>compile</SubType>
      <Link>MsTimer.c</Link>
    </Compile>
    <Compile Include="..\Gemeinsam\BusKomm.c">
      <SubType>compile</SubType>
      <Link>BusKomm.c</Link>
    </Compile>
    <Compile Include="..\Gemeinsam\FifoPuffer.c">
      <SubType>compile</SubType>
      <Link>FifoPuffer.c</Link>
    </Compile>
    <Compile Include="..\Gemeinsam\BusKomm2.c">
      <SubType>compile</SubType>
      <Link>BusKomm2.c</Link>
    </Compile>
    <Compile Include="..\Gemeinsam\BaudotCode.c">
      <SubType>compile</SubType>
      <Link>BaudotCode.c</Link>
    </Compile>
    <Compile Include="..\..\C-Libs\EepromTools.c">
      <SubType>compile</SubType>
      <Link>EepromTools.c</Link>
    </Compile>
  </ItemGroup>
</Project>